<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Mobilprog.ViewModel"
             x:Class="Mobilprog.View.SquadsPage"
             Title="{Binding Squad.Name}"
             BackgroundColor="#f0f2f5">

    <VerticalStackLayout Padding="20" Spacing="20">

        
        <Label Text="{Binding Squad.Name}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#333"
               HorizontalOptions="Center" />

        
        <Label Text="{Binding CloneCountText}"
               FontSize="16"
               TextColor="#777"
               HorizontalOptions="Center" />


        <CollectionView ItemsSource="{Binding Clones}"
                Margin="0,10,0,10"
                BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10"
                   Margin="5"
                   CornerRadius="12"
                   BackgroundColor="White"
                   HasShadow="True">

                        
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            
                            <Frame Grid.Column="0"
                           WidthRequest="70"
                           HeightRequest="70"
                           CornerRadius="8"
                           BackgroundColor="#ddd"
                           HasShadow="False">
                                <Image Source="{Binding Image}" Aspect="AspectFill"/>
                            </Frame>

                            
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#222"/>
                                <Label Text="{Binding Rank}"
                               FontSize="14"
                               TextColor="#555"/>
                            </VerticalStackLayout>
                        </Grid>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>



        <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
            <Button Text="Back"
                    Command="{Binding GoBackCommand}"
                    HeightRequest="45"
                    WidthRequest="120"
                    CornerRadius="12"
                    BackgroundColor="#607D8B"
                    TextColor="White"
                    FontAttributes="Bold"/>
            <Button Text="Delete All Clones"
                    Command="{Binding DeleteAllClonesCommand}"
                    HeightRequest="45"
                    WidthRequest="160"
                    CornerRadius="12"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    FontAttributes="Bold"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
