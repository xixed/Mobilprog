<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Mobilprog.ViewModel"
             x:Class="Mobilprog.View.BattleAddPage"
             Title="New Battle"
             BackgroundColor="#f0f2f5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            
            <Button Text="Back"
                    Command="{Binding GoBackCommand}"
                    HeightRequest="45"
                    WidthRequest="100"
                    CornerRadius="12"
                    BackgroundColor="#607D8B"
                    TextColor="White"
                    FontAttributes="Bold"
                    HorizontalOptions="Start" />

            
            <Label Text="Create New Battle"
                   FontAttributes="Bold"
                   FontSize="22"
                   HorizontalOptions="Center"
                   TextColor="#333" />

            <Entry Placeholder="Battle Name"
                   Text="{Binding NewBattle.Name}"
                   HeightRequest="45"
                   BackgroundColor="White"
                   />
            <Entry Placeholder="Location"
                   Text="{Binding NewBattle.Location}"
                   HeightRequest="45"
                   BackgroundColor="White"
                   />
            <DatePicker Date="{Binding NewBattle.Date}"
                        HeightRequest="45"
                        BackgroundColor="White"
                         />

            <Label Text="Republic Side"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#333" />
            <Picker Title="Select Squad"
                    ItemsSource="{Binding AllSquads}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedRepublicSquad}"
                    HeightRequest="45"
                    BackgroundColor="White"
                     />
            <Button Text="Add to Republic"
                    Command="{Binding AddRepublicSquadCommand}"
                    HeightRequest="45"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold" />
            

            <CollectionView ItemsSource="{Binding RepublicSquads}"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10"
                           Margin="5,2"
                           CornerRadius="10"
                           BackgroundColor="White"
                           HasShadow="True">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   TextColor="#222"
                                   VerticalOptions="Center" />
                                <Button Text="Delete"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BattleAddViewModel}}, Path=RemoveRepublicSquadCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#F44336"
                                    TextColor="White"
                                    CornerRadius="8"
                                    WidthRequest="80"
                                    HeightRequest="30"
                                    HorizontalOptions="End"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            
            <Label Text="Separatist Side"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#333" />
            <Picker Title="Select Squad"
                    ItemsSource="{Binding AllSquads}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedSeparatistSquad}"
                    HeightRequest="45"
                    BackgroundColor="White"
                     />
            <Button Text="Add to Separatists"
                    Command="{Binding AddSeparatistSquadCommand}"
                    HeightRequest="45"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding SeparatistSquads}"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10"
                           Margin="5,2"
                           CornerRadius="10"
                           BackgroundColor="White"
                           HasShadow="True">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   TextColor="#222"
                                   VerticalOptions="Center" />
                                <Button Text="Delete"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BattleAddViewModel}}, Path=RemoveSeparatistSquadCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#F44336"
                                    TextColor="White"
                                    CornerRadius="8"
                                    WidthRequest="80"
                                    HeightRequest="30"
                                    HorizontalOptions="End"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            
            <Button Text="Save Battle"
                    Command="{Binding SaveBattleCommand}"
                    HeightRequest="50"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


