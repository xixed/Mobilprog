<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobilprog.View.BattlePage"
             Title="Battles">

    <Grid Padding="20" RowSpacing="10">

       
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            
            <RowDefinition Height="*" />
            
            <RowDefinition Height="Auto" />
            
        </Grid.RowDefinitions>

        
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Fill" Spacing="15">
            <Button Text="Back" Command="{Binding GoBackCommand}" HorizontalOptions="StartAndExpand" />
            <Button Text="Add Battle" Command="{Binding AddBattleCommand}" HorizontalOptions="EndAndExpand" />
        </HorizontalStackLayout>

        
        <CollectionView Grid.Row="1" ItemsSource="{Binding Battles}" Margin="0,10,0,10" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BorderColor="#CCC" CornerRadius="8" HasShadow="True">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Location}" FontSize="14" TextColor="Gray" />
                                <Label Text="{Binding Date, StringFormat='{yyyy-MM-dd}'}" FontSize="12" TextColor="DarkGray" />
                            </VerticalStackLayout>

                            
                            <Image Grid.Column="1" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        
        <Button Grid.Row="2"
                Text="Run Simulation"
                Command="{Binding RunSimulationCommand}"
                BackgroundColor="#4F46E5"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,0"/>
    </Grid>
</ContentPage>
