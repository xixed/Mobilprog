<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             
             x:Class="Mobilprog.View.MainPage"
             Title="NewPage1">
    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Felső két gomb egymás mellett -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
            <Button Text="Clones" WidthRequest="120" />
            <Button Text="Battles" WidthRequest="120" />
        </HorizontalStackLayout>

        <!-- Lista, 2 oszlopos rácsban -->
        <CollectionView ItemsLayout="VerticalGrid, 2" Margin="0,15,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button
                        Text="Empty"
                        />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>